package main;
import "term/tui";
import "io";
import "os";
extern *void popen(buffer<i8> command, buffer<i8> mode);
extern i32 pclose(*void stream);
extern uint fread(buffer<i8> data, uint size, uint count, *void stream);

func quote(s string) string {
    out := "'";
    for (_, c := range s) { if (c == 39) out += "'\\''"; else { b := i8[]{c}; out += b -> string; } }
    return out + "'";
}
struct Reply { text string; code int; }
func git(args string) Reply {
    command := "GIT_TERMINAL_PROMPT=0 GIT_EDITOR=true GIT_SEQUENCE_EDITOR=true git --no-pager -c color.ui=false " + args + " </dev/null 2>&1\0";
    stream := extern.popen(command.data, "r\0".data);
    if (stream == null) return Reply{"Cannot start Git", 1};
    text := ""; chunk := i8[16384];
    for (;;) {
        count := extern.fread(chunk.data,1,16384,stream) -> int;
        if (count == 0) break;
        text += chunk[:count] -> string;
    }
    code := extern.pclose(stream);
    return Reply{text, code < 0 ? 1 : (code & 127) != 0 ? 128 + (code & 127) : code >> 8};
}
func lines(s string) string[] {
    result := string[]{}; start := 0;
    for (i, c := range s) {
        if (c == 10) { result.append(cleanLine(s[start:i])); start = i+1; }
    }
    if (start < len(s)) {
        last := cleanLine(s[start:]);
        if (last != "") result.append(last);
    }
    return result;
}
func cleanLine(s string) string {
    // Git output normally needs no filtering; avoid rebuilding those lines.
    dirty := false;
    for (_, c := range s) { if (c < 32 && c >= 0 && c != 9) dirty = true; }
    if (!dirty) return s;
    bytes := i8[len(s)]; data := bytes.data; count := 0;
    for (_, c := range s) { if (c >= 32 || c < 0 || c == 9) { data[count] = c; count++; } }
    return bytes[:count] -> string;
}
// Clip by UTF-8 scalars, preserving complete terminal glyphs and SGR sequences.
func cut(s string, n int) string {
    cells := 0; escape := false; end := 0;
    for (i, c := range s) {
        byte := c -> u8;
        if (c == 27) escape = true;
        if (!escape && (byte < 128 || byte >= 192)) { if (cells >= n) break; cells++; }
        end = i+1;
        if (escape && c == 109) escape = false;
    }
    return s[:end];
}
// Accumulate bytes in growable storage rather than copying a string per byte.
func appendText(out *i8[], text string) {
    for (_, c := range text) (*out).append(c);
}
func repeat(s string, n int) string {
    out := ""; block := s;
    for (n > 0) {
        if (n % 2 != 0) out += block;
        n /= 2;
        if (n > 0) block += block;
    }
    return out;
}
func tail(s string, offset int) string { out := ""; for (i,c := range s) { if (i >= offset) { b := i8[]{c}; out += b -> string; } } return out; }
struct App {
    rows string[]; refs string[]; selected int; width int; height int;
    mode string; preview bool; detail string[]; detailVersion int; detailDirty bool; scroll int; status string;
    source string; rebase bool; rebaseKind string; head string;
    commandActions Action[]; commandHaystacks string[]; commandBackdrop string[]; commandSearch string; busy bool; fields string[]; field int; top int; previous string; prompt string; input string; pending string; filter string; branch string;
}
func (a *App) load() {
    branchLines := lines(git("symbolic-ref --short -q HEAD").text);
    a.branch = len(branchLines) > 0 ? branchLines[0] : "detached HEAD";
    a.head = cut(git("rev-parse --verify HEAD").text, 40);
    a.rows = string[]{}; a.refs = string[]{};
    if (a.mode == "files") {
        a.rows = lines(git("status --short --untracked-files=all").text);
        for (_, row := range a.rows) { b := ""; for (i,c := range row) { if (i >= 3) { x := i8[]{c}; b += x -> string; } } a.refs.append(b); }
    } else if (a.mode == "branches") {
        a.rows = lines(git("branch --format='%(refname:short)'").text); a.refs = a.rows;
    } else if (a.mode == "operations") {
        a.rows = lines(git("reflog --format='%h %gd %gs' -100").text);
        for (i,_ := range a.rows) a.refs.append("HEAD@{" + io.Sprint(i) + "}");
    } else {
        a.loadGraph();
    }
    if (a.selected >= len(a.rows)) a.selected = len(a.rows) - 1;
    if (a.selected < 0) a.selected = 0;
    a.refresh();
}
func (a *App) ref() string { if (a.selected < len(a.refs)) { values := a.refs; index := a.selected; return values[index]; } return ""; }
struct DetailDone { version int; rows string[]; }
func (a *App) refresh() {
    a.scroll = 0; a.detail = string[]{}; a.detailVersion++; a.detailDirty = true;
}
func (a *App) loadDetail() tui.Cmd {
    if (!a.detailDirty || a.busy || (!a.preview && a.mode != "detail")) return tui.NoCmd;
    if (a.mode != "log" && a.mode != "files" && a.mode != "branches" && a.mode != "operations" && a.mode != "detail") return tui.NoCmd;
    a.detailDirty = false;
    version := a.detailVersion; r := a.ref();
    mode := a.mode == "detail" ? a.previous : a.mode;
    return func() tui.Msg {
        text := "";
        if (mode == "files") {
            text = git("diff HEAD -- " + quote(r)).text;
            if (text == "") text = git("diff --no-index -- /dev/null " + quote(r)).text;
        } else if (mode == "branches") text = git("log -10 --oneline " + quote(r)).text;
        else if (r != "") text = git("show --stat --patch " + quote(r)).text;
        else text = git("status").text;
        return DetailDone{version,lines(text)};
    };
}
func (a *App) Init() tui.Cmd { return a.loadDetail(); }
func (a *App) Update(message tui.Msg) (tui.Model, tui.Cmd) {
    switch (e := message.(type)) {
    case DetailDone:
        if (e.version == a.detailVersion) a.detail = e.rows;
    case CommandDone:
        a.busy = false; a.mode = "log"; a.load(); a.previous = "log"; a.mode = "detail";
        a.detail = lines("$ git " + e.command + "\n" + e.result.text + "\nExit status: " + io.Sprint(e.result.code));
        a.detailDirty = false; a.scroll = 0; a.status = e.result.code == 0 ? "Command completed" : "Command failed · see output";
    case tui.WindowSizeMsg: a.width = e.Width; a.height = e.Height;
    case tui.EOFMsg: return a, tui.Quit;
    case tui.KeyMsg:
        k := e.Text;
        if (a.busy) return a,tui.NoCmd;
        if (e.Key == "ctrl+c") return a, tui.Quit;
        if (a.prompt != "") {
            if (e.Key == "esc") { a.prompt = ""; a.input = ""; a.fields = string[]{}; }
            else if (e.Key == "backspace") { a.input = cut(a.input, width(a.input)-1); }
            else if (e.Key == "enter") {
                if (a.prompt == "search") { a.filter = a.input; a.mode = "log"; }
                else if (a.prompt == "Git arguments") {
                    parsed := gitArguments(a.input);
                    if (parsed.hasError()) { a.status = parsed.error(); return a,tui.NoCmd; }
                    a.pending = parsed.unwrap(); a.prompt = "confirm"; a.input = ""; return a,tui.NoCmd;
                } else if (a.prompt == "confirm") {
                    if (a.input != "yes") { a.status = "Type yes to run, or Esc to cancel"; return a,tui.NoCmd; }
                    return a,a.execute(a.pending);
                } else if (len(a.fields) > 0) {
                    if (a.input == "") { a.status = "A value is required"; return a,tui.NoCmd; }
                    a.pending += " " + quote(a.input); a.input = ""; a.field++;
                    index := a.field; a.prompt = index < len(a.fields) ? a.fields[index] : "confirm";
                    if (a.field >= len(a.fields)) a.fields = string[]{};
                    return a,tui.NoCmd;
                } else { return a,a.execute(a.pending + quote(a.input)); }
                a.prompt = ""; a.input = ""; a.load();
            } else a.input += e.Text;
            return a, tui.NoCmd;
        }
        if (a.rebase) {
            if (e.Key == "esc") { a.rebase = false; a.status = "Rebase cancelled"; return a,tui.NoCmd; }
            if (k == "s") a.rebaseKind = "revision";
            if (k == "b") a.rebaseKind = "branch";
            if (e.Key == "enter") {
                dest := a.ref();
                if (dest == "" || dest == a.source) { a.status = "Choose a different destination"; return a,tui.NoCmd; }
                if (a.rebaseKind == "branch") a.pending = "rebase --onto " + quote(dest) + " " + quote(a.source + "^") + " " + quote(a.branch);
                else a.pending = "rebase --onto " + quote(dest) + " " + quote(a.source + "^") + " " + quote(a.source);
                a.prompt = "confirm"; a.input = ""; a.rebase = false;
                return a,tui.NoCmd;
            }
            if (k != "j" && k != "k" && e.Key != "up" && e.Key != "down" && e.Key != "home" && e.Key != "end") return a,tui.NoCmd;
        }
        if (a.mode == "commands") {
            if (e.Key == "down" || e.Key == "ctrl+n") { if (a.selected+1 < len(a.rows)) a.selected++; }
            else if (e.Key == "up" || e.Key == "ctrl+p") { if (a.selected > 0) a.selected--; }
            else if (e.Key == "enter") a.startCommand();
            else if (e.Key == "esc") { a.mode = "log"; a.selected = 0; a.load(); }
            else if (e.Key == "backspace") { a.commandSearch = cut(a.commandSearch,width(a.commandSearch)-1); a.filterCommands(); }
            else if (e.Key == "ctrl+u") { a.commandSearch = ""; a.filterCommands(); }
            else if (e.Text != "") { a.commandSearch += e.Text; a.filterCommands(); }
            return a,tui.NoCmd;
        }
        if (k == ":") { a.prompt = "Git arguments"; a.input = ""; return a,tui.NoCmd; }
        if (k == "g") { a.openCommands(); return a,tui.NoCmd; }
        if (k == "q") { if (a.mode == "detail" || a.mode == "help") { a.mode = a.previous == "" ? "log" : a.previous; return a,tui.NoCmd; } return a, tui.Quit; }
        if (k == "?" || e.Key == "f1") { if (a.mode == "help") a.mode = a.previous; else { a.previous = a.mode; a.mode = "help"; } return a, tui.NoCmd; }
        if (k == "j" || e.Key == "down") { a.move(1); }
        if (k == "k" || e.Key == "up") { a.move(-1); }
        if (e.Key == "home") { a.selected = 0; a.refresh(); }
        if (e.Key == "end" || k == "G") { a.selected = len(a.rows)-1; if (a.selected < 0) a.selected = 0; a.refresh(); }
        if (e.Key == "ctrl+n" || e.Key == "ctrl+d") a.scroll += e.Key == "ctrl+d" ? a.height / 2 : 1;
        if (e.Key == "ctrl+p" || e.Key == "ctrl+u") { a.scroll -= e.Key == "ctrl+u" ? a.height / 2 : 1; if (a.scroll < 0) a.scroll = 0; }
        if (a.scroll >= len(a.detail)) a.scroll = len(a.detail) > 0 ? len(a.detail)-1 : 0;
        if (e.Key == "pgdown" || e.Key == "pgup") { for (i := 0; i < a.height / 4; i++) a.move(e.Key == "pgdown" ? 1 : -1); }
        if (k == "p") a.preview = !a.preview;
        if ((k == "l" || e.Key == "right" || e.Key == "enter" || k == "d") && a.mode != "detail") { a.previous = a.mode; a.mode = "detail"; a.scroll = 0; }
        if (k == "h" || e.Key == "left" || e.Key == "esc") { a.mode = "log"; a.load(); }
        if (k == "f") { a.mode = "files"; a.selected = 0; a.load(); }
        if (k == "b") { a.mode = "branches"; a.selected = 0; a.load(); }
        if (k == "o") { a.mode = "operations"; a.selected = 0; a.load(); }
        if (k == "R") a.load();
        if (k == "/") { a.prompt = "search"; a.input = a.filter; }
        if (k == "c") { a.prompt = "commit message"; a.pending = "commit -m "; }
        if (k == "B") { a.prompt = "new branch"; a.pending = "branch "; }
        if (k == "s" && a.mode == "files") { a.status = git("add -- " + quote(a.ref())).text; a.load(); }
        if (k == "u" && a.mode == "files") { a.status = git("restore --staged -- " + quote(a.ref())).text; a.load(); }
        if (k == "r" && a.mode == "log" && a.ref() != "") {
            a.source = a.ref(); a.rebase = true; a.rebaseKind = "revision";
            a.status = "Select destination · Enter rebase · Esc cancel";
        }
        if (k == "C") { a.prompt = "confirm"; a.pending = "-c core.editor=true rebase --continue"; }
        if (k == "A") { a.prompt = "confirm"; a.pending = "rebase --abort"; }
        if (k == "e" || k == "x" || k == "a") {
            a.prompt = "confirm"; a.input = "";
            if (k == "e") a.pending = "switch --detach " + quote(a.ref());
            if (k == "e" && a.mode == "branches") a.pending = "switch " + quote(a.ref());
            if (k == "x") a.pending = "cherry-pick " + quote(a.ref());
            if (k == "a") a.pending = "revert --no-edit " + quote(a.ref());
        }
    }
    return a, a.loadDetail();
}
func main() int {
    args := os.Args();
    for (_, arg := range args) { if (arg == "--help") { io.Println("gitui — jjui-inspired Git interface\nRun inside a Git repository. ocean run .\nUse ? for key bindings. --snapshot prints a noninteractive view."); return 0; } }
    repo := git("rev-parse --show-toplevel");
    if (repo.code != 0) { io.Println(repo.text); return 1; }
    app := App{width: 100, height: 32, mode: "log", preview: false}; app.load();
    for (_, arg := range args) { if (arg == "--snapshot") { io.Println(app.View()); return 0; } }
    program := tui.NewProgram(&app, tui.Options{AltScreen: true}); program.Run().unwrap(); return 0;
}
