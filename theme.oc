package main;

// jjui ba61a80: internal/config/default/default.toml, default dark theme.
// ANSI colors intentionally follow the terminal palette, as upstream does.
func style(role string) string {
    switch (role) {
    case "dimmed": return "\x1b[90m";
    case "title": return "\x1b[1;35m";
    case "shortcut": return "\x1b[35m";
    case "help title": return "\x1b[1;32m";
    case "revset title": return "\x1b[35m";
    case "revset text": return "\x1b[1;32m";
    case "status title": return "\x1b[1;30;45m";
    case "git title": return "\x1b[1;38;5;230;48;5;62m";
    case "git selected": return "\x1b[1;36m";
    case "git matched": return "\x1b[1;35m";
    case "confirmation": return "\x1b[1;35m";
    case "success": return "\x1b[32m";
    case "error": return "\x1b[31m";
    case "selected": return "\x1b[100m";
    }
    return "\x1b[0m";
}
func painted(role string, text string) string { return style(role) + text + "\x1b[0m"; }

// Upstream status.groupedHelpView: magenta key, dim description, bullet separators.
// Reserve room for the 'more' hint instead of cutting a binding in half.
func shortcuts(entries string[], available int) string {
    out := "";
    more := painted("shortcut", "?") + painted("dimmed", " more");
    for (i, entry := range entries) {
        split := 0;
        for (split < len(entry) && entry[split] != 32) split++;
        label := painted("shortcut",entry[:split]) + painted("dimmed",entry[split:]);
        separator := i > 0 ? painted("dimmed"," • ") : "";
        reserve := i+1 < len(entries) ? width(more)+3 : 0;
        if (width(out)+width(separator)+width(label)+reserve > available) {
            if (width(out)+width(separator)+width(more) <= available) out += separator + more;
            break;
        }
        out += separator + label;
    }
    return out;
}
func menuLabel(text string, query string, selected bool) string {
    base := selected ? style("git selected") : style("text");
    if (query == "") return base + text;
    lower := lowerAscii(text); needle := lowerAscii(query);
    out := base;
    for (i := 0; i < len(text);) {
        if (i+len(needle) <= len(text) && lower[i:i+len(needle)] == needle) {
            out += style("git matched") + text[i:i+len(needle)] + "\x1b[0m" + base; i += len(needle);
        } else { out += text[i:i+1]; i++; }
    }
    return out;
}
